{
  "name": "venta-backend",
  "version": "1.0.0",
  "description": "Serveur backend pour le projet Venta avec IA et système RAG",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/*.test.js\"",
    "test:openai": "node --test test/openai.js",
    "eval:rag": "node scripts/eval-rag.js",
    "update-rag": "node scripts/update-rag.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "mongoose": "^9.1.1",
    "openai": "^4.67.3"
  },
  "keywords": [
    "ai",
    "rag",
    "chat",
    "backend"
  ],
  "author": "Venta Project",
  "license": "MIT"
}
