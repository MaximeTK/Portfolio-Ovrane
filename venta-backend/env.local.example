# === CORE BACKEND ===
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# CORS: comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_NGROK_ORIGINS=true
LOG_CORS=false
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

# === AUTH ===
# 32-byte hex secret for HMAC cookie signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required to register a new account (defense against drive-by signups)
INVITE_CODE=

# === MONGODB ===
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?appName=OvraneDB

# === RUNPOD ADAPTER ===
# mock = in-memory simulator (no GPU billed). sidecar = call Flask deploy/webui/app.py.
RUNPOD_BACKEND=mock
RUNPOD_SIDECAR_URL=http://127.0.0.1:5005

# === AI MODEL ===
# Modèle: gpt-5-mini via l'API Responses (voir OPENAI_CONFIG dans src/lib/messages.js)
OPENAI_API_KEY=

# === TTS ===
# Order: ElevenLabs -> OpenAI -> Web Speech API
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy
# Force browser-only fallback
TTS_DEFAULT=false
