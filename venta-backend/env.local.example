# === Serveur ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# === Réseau ===
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_NGROK_ORIGINS=true
LOG_CORS=false
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

# === Admin ===
ADMIN_API_KEY=

# === Inscription ===
INVITE_CODE=

# === MongoDB ===
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority&appName=OvraneDB
# Obligatoire, sans repli : le serveur refuse de démarrer si vide.
MONGODB_DB=venta_local
# MONGODB_DB=venta

# === OpenAI ===
OPENAI_API_KEY=
# Defaut si absent : gpt-5-mini / medium / medium (src/lib/messages.js).
# API Responses uniquement : reasoning.effort exclut la famille gpt-4o.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium

# === TTS ===
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
TTS_DEFAULT=false