# === Serveur ===
PORT=3001
# Obligatoire : production, development ou test. Absent, le serveur refuse de démarrer.
NODE_ENV=development
# Toujours activé en production (proxy de Render).
TRUST_PROXY=false
# Tracage par requete (tools, RAG, tokens). Muet si absent.
LOG_VERBOSE=false

# === Secret partagé avec le front ===
# Même valeur côté Next (en-tête X-Ovrane-Service). Obligatoire en production ;
# hors production, les deux côtés prennent dev-ovrane-service s'il est vide.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVICE_SECRET=

# === Illusion ===
# Illusion lit et écrit la même base (MONGODB_URI, MONGODB_DB).
# Pages d'Illusion intégrées au site (/api/illusion/app/*) : adresse de son serveur (défaut http://127.0.0.1:8000)
# et secret qu'il attend de ce backend, le même que PIPELINE_SECRET_OVRANE chez lui. Vide : relais coupé (503).
# En production, ILLUSION_URL doit être en https:// (sauf 127.0.0.1) : sinon le serveur refuse de démarrer.
ILLUSION_URL=
ILLUSION_SERVICE_SECRET=

# === Inscription ===
INVITE_CODE=

# === E-mails (mot de passe oublié) ===
# Adresse publique du front, pour les liens des e-mails. Vide : http://localhost:3000 hors production, aucun lien en production.
SITE_URL=
# Clé de l'API Resend et expéditeur d'un domaine vérifié chez Resend. Vides : aucun e-mail ne part.
RESEND_API_KEY=
MAIL_FROM=Ovrane <no-reply@exemple.fr>

# === MongoDB ===
# Obligatoires, sans repli : le serveur refuse de démarrer si l'un est vide ou si la base est injoignable.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority&appName=OvraneDB
MONGODB_DB=venta_local
# MONGODB_DB=venta

# === OpenAI ===
# Obligatoire.
OPENAI_API_KEY=
# Defaut si absent : gpt-5-mini / medium / medium (src/config.js).
# API Responses uniquement : reasoning.effort exclut la famille gpt-4o.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
# Plafond de sortie par appel, raisonnement compris (défaut 1500).
OPENAI_MAX_OUTPUT_TOKENS=1500

# === Plafonds de dépense par jour, tous visiteurs confondus ===
# Au-delà, le chat répond un message fixe sans appeler le modèle, et la voix passe au navigateur. 0 ou vide : aucune limite.
BUDGET_CHAT_PAR_JOUR=400
BUDGET_TTS_PAR_JOUR=600

# === TTS ===
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# true : la voix du navigateur lit tout, aucun fournisseur appelé.
TTS_DEFAULT=false
