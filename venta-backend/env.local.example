# Configuration du backend
BACKEND_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# === SÉCURITÉ & RÉSEAU (BACKEND) ===
# URL du frontend (utilisé pour récupérer la liste des assets via /api/frontend/assets)
FRONTEND_URL=http://localhost:3000

# CORS: liste d'origines autorisées (séparées par des virgules)
# Exemple: http://localhost:3000,https://mon-site.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Autoriser les origines ngrok (DEV uniquement)
ALLOW_NGROK_ORIGINS=true
LOG_CORS=false

# Limite de taille des requêtes JSON (anti-DoS)
REQUEST_BODY_LIMIT=1mb

# Si backend derrière un reverse-proxy (Nginx, etc.)
TRUST_PROXY=false

# Clé d'accès pour les routes admin (/api/admin/*) - à définir en PROD
ADMIN_API_KEY=change-me-in-prod

# Configuration Next.js
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# === SÉLECTION DU MODÈLE D'IA ===
# Options: "gpt5" (GPT-5-mini avec Responses API) ou "gpt4o-mini" (GPT-4o-mini avec Chat Completions API)
# Par défaut: "gpt5"
AI_MODEL=gpt5

# === SYNTHÈSE VOCALE (TTS) - Système de Fallback ===
# Le système essaie dans l'ordre : Eleven Labs → OpenAI → Web Speech API (gratuit)

# Option 1 : Eleven Labs TTS (Meilleure qualité, premium)
ELEVEN_API_KEY=your_elevenlabs_api_key_here
ELEVEN_VOICE_ID=your_voice_id_here

# Option 2 : OpenAI TTS (Fallback, bonne qualité, moins cher)
OPENAI_API_KEY=sk-proj-
# Option 2 bis : OpenAI Realtime (latence très faible, voix naturelles)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy

MONGODB_URI=mongodb+srv://

# Forcer le fallback navigateur uniquement (true/false)
# Nouveau nom (standard)
TTS_DEFAULT=false
# Ancien nom (compatibilité)
TTS-DEFAULT=false

# Option 3 : Web Speech API (Fallback gratuit, automatique)
# Aucune configuration nécessaire - Intégré au navigateur
